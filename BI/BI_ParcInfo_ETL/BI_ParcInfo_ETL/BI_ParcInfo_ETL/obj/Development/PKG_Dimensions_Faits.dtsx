  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\LOAD_Dimensions_Faits"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{A8CFD049-613D-4D60-8D00-5928293D3075}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_Dimensions_Faits"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A55D3E77-72B7-424B-B35A-B48B40C01CDF}"
          SQLTask:SqlStatementSource="/* ============================================================&#xA;   13_Charger_DWH_Complet.sql (VERSION DEFINITIVE)&#xA;   Recharge ENTIEREMENT le DWH a chaque execution (vide puis&#xA;   reinsere tout) -- plus simple et plus robuste que le MERGE,&#xA;   aucun risque de doublons. A utiliser desormais a la place&#xA;   de 06b_SSIS_SansGO.sql dans la tache SSIS LOAD_Dimensions_Faits.&#xA;   ============================================================ */&#xA;&#xA;USE [DWH_ParcInfo]&#xA;&#xA;-- 1) Vider dans l'ordre (enfants d'abord, a cause des cles etrangeres)&#xA;DELETE FROM dbo.Fact_Panne;&#xA;DELETE FROM dbo.Fact_Mouvement;&#xA;DELETE FROM dbo.Dim_Materiel;&#xA;DELETE FROM dbo.Dim_TypeMateriel;&#xA;DELETE FROM dbo.Dim_Etat;&#xA;DELETE FROM dbo.Dim_Localisation;&#xA;DELETE FROM dbo.Dim_Employe;&#xA;&#xA;DBCC CHECKIDENT ('dbo.Dim_TypeMateriel', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.Dim_Etat', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.Dim_Localisation', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.Dim_Employe', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.Dim_Materiel', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.Fact_Panne', RESEED, 0);&#xA;&#xA;-- 2) Recharger les dimensions (une ligne par cle metier, garanti sans doublon grace a DISTINCT + GROUP BY)&#xA;INSERT INTO dbo.Dim_TypeMateriel (TypeMaterielId, Libelle)&#xA;SELECT Id, MAX(Libelle) FROM Staging_ParcInfo.dbo.Stg_TypesMateriels GROUP BY Id;&#xA;&#xA;INSERT INTO dbo.Dim_Etat (EtatId, Libelle, EstEtatPanne)&#xA;SELECT Id, MAX(Libelle), MAX(CASE WHEN Libelle = N'Panne' THEN 1 ELSE 0 END)&#xA;FROM Staging_ParcInfo.dbo.Stg_EtatsMateriels&#xA;GROUP BY Id;&#xA;&#xA;INSERT INTO dbo.Dim_Localisation (LocalisationId, Nom)&#xA;SELECT Id, MAX(Nom) FROM Staging_ParcInfo.dbo.Stg_Localisations GROUP BY Id;&#xA;&#xA;INSERT INTO dbo.Dim_Employe (EmployeId, Matricule, Nom, Prenom, Service, Poste)&#xA;SELECT Id, MAX(Matricule), MAX(Nom), MAX(Prenom), MAX(Service), MAX(Poste)&#xA;FROM Staging_ParcInfo.dbo.Stg_Employes&#xA;GROUP BY Id;&#xA;&#xA;INSERT INTO dbo.Dim_Materiel&#xA;    (MaterielId, CodeBarre, Libelle, SK_TypeMateriel, Marque, Modele, NumeroSerie,&#xA;     DateAcquisition, PrixAchat, DureeVieTheoriqueAnnees, Actif)&#xA;SELECT&#xA;    s.Id, MAX(s.CodeBarre), MAX(s.Libelle), MAX(dt.SK_TypeMateriel), MAX(s.Marque), MAX(s.Modele),&#xA;    MAX(s.NumeroSerie), CAST(MAX(s.DateAcquisition) AS DATE), MAX(s.PrixAchat),&#xA;    MAX(s.DureeVieTheoriqueAnnees), MAX(CAST(s.Actif AS INT))&#xA;FROM Staging_ParcInfo.dbo.Stg_Materiels s&#xA;JOIN dbo.Dim_TypeMateriel dt ON dt.TypeMaterielId = s.TypeMaterielId&#xA;GROUP BY s.Id;&#xA;&#xA;-- 3) Fact_Mouvement&#xA;INSERT INTO dbo.Fact_Mouvement&#xA;    (MouvementId, SK_Materiel, SK_Date, SK_Employe, SK_Localisation, SK_EtatAvant, SK_EtatApres,&#xA;     TypeMouvement, DateHeureMouvement, DureeDepuisMouvementPrecedentH, CoutReparation)&#xA;SELECT&#xA;    s.Id, dm.SK_Materiel, CONVERT(INT, FORMAT(s.DateMouvement, 'yyyyMMdd')),&#xA;    de.SK_Employe, dl.SK_Localisation, dea.SK_Etat, deb.SK_Etat,&#xA;    s.TypeMouvement, s.DateMouvement,&#xA;    DATEDIFF(MINUTE, LAG(s.DateMouvement) OVER (PARTITION BY s.MaterielId ORDER BY s.DateMouvement, s.Id), s.DateMouvement) / 60.0,&#xA;    s.CoutReparation&#xA;FROM Staging_ParcInfo.dbo.Stg_MouvementsMateriels s&#xA;JOIN dbo.Dim_Materiel dm       ON dm.MaterielId = s.MaterielId&#xA;JOIN dbo.Dim_Etat dea           ON dea.EtatId = s.AncienEtatId&#xA;JOIN dbo.Dim_Etat deb           ON deb.EtatId = s.NouvelEtatId&#xA;JOIN dbo.Dim_Localisation dl    ON dl.LocalisationId = s.LocalisationId&#xA;LEFT JOIN dbo.Dim_Employe de    ON de.EmployeId = s.EmployeId;&#xA;&#xA;-- 4) Fact_Panne&#xA;;WITH Debuts AS (&#xA;    SELECT s.Id AS MouvementId, s.MaterielId, s.DateMouvement AS DateDeclaration&#xA;    FROM Staging_ParcInfo.dbo.Stg_MouvementsMateriels s&#xA;    JOIN Staging_ParcInfo.dbo.Stg_EtatsMateriels e ON e.Id = s.NouvelEtatId&#xA;    WHERE e.Libelle = N'Panne'&#xA;),&#xA;Resolutions AS (&#xA;    SELECT d.MouvementId AS MouvementDebutId, d.MaterielId, d.DateDeclaration,&#xA;           (&#xA;               SELECT TOP 1 s2.DateMouvement&#xA;               FROM Staging_ParcInfo.dbo.Stg_MouvementsMateriels s2&#xA;               JOIN Staging_ParcInfo.dbo.Stg_EtatsMateriels e2 ON e2.Id = s2.NouvelEtatId&#xA;               WHERE s2.MaterielId = d.MaterielId&#xA;                 AND s2.DateMouvement &gt; d.DateDeclaration&#xA;                 AND e2.Libelle IN (N'En stock', N'Affecté')&#xA;               ORDER BY s2.DateMouvement ASC&#xA;           ) AS DateResolution&#xA;    FROM Debuts d&#xA;)&#xA;INSERT INTO dbo.Fact_Panne&#xA;    (SK_Materiel, SK_Date_Declaration, SK_Date_Resolution, DateHeureDeclaration, DateHeureResolution,&#xA;     DureeImmobilisationHeures, DureeDepuisPannePrecedenteH, CoutReparation, EstRecurrente)&#xA;SELECT&#xA;    dm.SK_Materiel,&#xA;    CONVERT(INT, FORMAT(r.DateDeclaration, 'yyyyMMdd')),&#xA;    CASE WHEN r.DateResolution IS NULL THEN NULL ELSE CONVERT(INT, FORMAT(r.DateResolution, 'yyyyMMdd')) END,&#xA;    r.DateDeclaration, r.DateResolution,&#xA;    CASE WHEN r.DateResolution IS NULL THEN NULL ELSE DATEDIFF(MINUTE, r.DateDeclaration, r.DateResolution) / 60.0 END,&#xA;    DATEDIFF(MINUTE, LAG(r.DateDeclaration) OVER (PARTITION BY r.MaterielId ORDER BY r.DateDeclaration), r.DateDeclaration) / 60.0,&#xA;    (SELECT MAX(sm.CoutReparation) FROM Staging_ParcInfo.dbo.Stg_MouvementsMateriels sm&#xA;     WHERE sm.MaterielId = r.MaterielId AND sm.DateMouvement = r.DateResolution),&#xA;    0&#xA;FROM Resolutions r&#xA;JOIN dbo.Dim_Materiel dm ON dm.MaterielId = r.MaterielId;&#xA;&#xA;UPDATE fp SET EstRecurrente = 1&#xA;FROM dbo.Fact_Panne fp&#xA;WHERE fp.DureeDepuisPannePrecedenteH IS NOT NULL AND fp.DureeDepuisPannePrecedenteH &lt;= (90 * 24);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
