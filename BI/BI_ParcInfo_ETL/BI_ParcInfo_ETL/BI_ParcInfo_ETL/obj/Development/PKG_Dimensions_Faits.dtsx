  <DTS:ConnectionManagers>
    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[Molka\SQLEXPRESS.DWH_ParcInfo]"
      DTS:CreationName="OLEDB"
      DTS:DTSID="{A55D3E77-72B7-424B-B35A-B48B40C01CDF}"
